    <CheatEntry>
      <ID>333</ID>
      <Description>"Get player base"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{ Game   : soulstorm.exe
  Version: 
  Date   : 2022-06-08
  Author : Fucker

  This script does blah blah blah
}

[ENABLE]

aobscanmodule(INJECT,WXPMod.dll,3B 87 B8 01 00 00 75 19 8B CE E8 50) // should be unique
alloc(newmem,$1000)
alloc(player,4)
registersymbol(player)

label(code)
label(return)

player:
dd 0

newmem:

code:
  push ebx
  cmp eax,[edi+000001B8]
  mov ebx,[edi+000001B8]
  mov [player],ebx
  pop ebx
  jmp return

INJECT:
  jmp newmem
  nop
return:
registersymbol(INJECT)

[DISABLE]

INJECT:
  db 3B 87 B8 01 00 00

unregistersymbol(INJECT)
unregistersymbol(player)
dealloc(player)
dealloc(newmem)

{
