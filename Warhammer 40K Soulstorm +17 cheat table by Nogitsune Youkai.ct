    <CheatEntry>
      <ID>268</ID>
      <Description>"Fast units and research"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{ Game   : soulstorm.exe
  Version: 
  Date   : 2022-05-07
  Author : archivarius-cat

  This script does blah blah blah
}

[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat

 
 
aobscanmodule(INJECT,WXPMod.dll,8B 48 0C 89 4F 0C 8B 50 10 89 57 10 83 3F) // should be unique
alloc(newmem,$1000)

label(code)
label(return)

newmem:
mov [eax+0C],#0
jmp return

code:
  mov ecx,[eax+0C]
  mov [edi+0C],ecx
  jmp return

INJECT:
  jmp newmem
  nop
