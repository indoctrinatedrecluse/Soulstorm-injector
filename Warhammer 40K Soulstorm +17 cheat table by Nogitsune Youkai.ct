  <LuaScript>function SupportButtonPressed(sender)
infoBox = createForm()
    infoBox.Caption = "Info"
    infoBox.Width = 300
    infoBox.Height = 200
    infoBox.Position = 'poScreenCenter'
    infoBox.OnClose = function(sender)
        infoBox.destroy()
    end
    link = createLabel(infoBox)
    link.Caption = "Поддержать на Boosty(это ссылка)"
    link.Left = (infoBox.Width - link.Width) / 2    -- center link in middle of infoBox form
    link.Top = (infoBox.Height - link.Height) / 2
    link.Font.Color = clBlue    -- change color of link to blue
    link.OnClick = function(sender)
        shellExecute("https://boosty.to/nogitsuneyoukai")
    end
    text = createLabel(infoBox)
    text.Caption = "Юmoney кошелек: 4100115825445039"
    text.setPosition(55,170)
    text.Font.Color = clRed
end

